{
  "name": "gug-cli",
  "version": "0.2.0",
  "description": "GUG-cli — an agentic OS: run many AI agents (Claude, Claude Code, local models) from one place.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gug": "bin/gug.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node bin/dev.mjs",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node bin/gug.mjs serve",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.1"
  }
}
