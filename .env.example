# Copy this file to .env and fill in your values.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: enables AI replies when someone @mentions the bot or replies to it.
# Get a key at https://console.anthropic.com/. Without it, @mentions get a mashup.
ANTHROPIC_API_KEY=

# Optional tweaks
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium        # low | medium | high - how hard Claude thinks
# CHAT_HISTORY=20             # how many recent channel messages Claude reads
# WEIDIDDY_DB=weididdy.db     # where learned words and settings are stored
# DEV_GUILD_ID=               # your server's ID: slash commands show up instantly there
